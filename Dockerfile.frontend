FROM node:22-alpine AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder

WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .

# The local-auth frontend proxies requests to the Python Cloud Run service.
# These values are evaluated while Next.js is built because next.config.mjs
# uses them to generate the rewrites.
ARG PYTHON_API_BASE_URL
ENV NEXT_PUBLIC_AUTH_MODE=local
ENV PYTHON_API_BASE_URL=${PYTHON_API_BASE_URL}
ENV NODE_ENV=production

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app
ARG PYTHON_API_BASE_URL
ENV NODE_ENV=production
ENV PORT=8080
ENV NEXT_PUBLIC_AUTH_MODE=local
ENV PYTHON_API_BASE_URL=${PYTHON_API_BASE_URL}

COPY --from=builder /app ./

EXPOSE 8080
CMD ["sh", "-c", "npx next start -p ${PORT:-8080}"]
